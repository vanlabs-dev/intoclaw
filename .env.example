# IntoClaw environment variables
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# Required for chain write operations (staking, transfers, wallet)
AGCLI_PASSWORD=

# Required for Desearch search tools (tao_search_web, tao_search_twitter)
# Get a key at https://desearch.ai
DESEARCH_API_KEY=
