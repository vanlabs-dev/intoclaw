{
  "name": "@intoclaw/mcp-server",
  "version": "0.1.0",
  "description": "Bittensor-native MCP server for OpenClaw agents",
  "type": "module",
  "license": "MIT",
  "author": "vanlabs-dev",
  "repository": "https://github.com/vanlabs-dev/intoclaw",
  "homepage": "https://intotao.app",
  "bugs": "https://github.com/vanlabs-dev/intoclaw/issues",
  "keywords": [
    "bittensor",
    "tao",
    "mcp",
    "model-context-protocol",
    "openclaw",
    "agent"
  ],
  "files": [
